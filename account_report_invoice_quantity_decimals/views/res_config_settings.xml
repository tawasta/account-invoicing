<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_config_settings" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.invoice.decimal.precision</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="invoicing_settings" position="inside">
                <setting
                    id="invoice_report_decimal_precision"
                    help="Set Decimal Precision on invoice pdf print's product quantities"
                >
                    <field name="invoice_report_decimal_precision" />
                </setting>
            </block>
        </field>
    </record>
</odoo>
