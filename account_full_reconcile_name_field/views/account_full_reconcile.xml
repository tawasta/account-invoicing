<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record id="account_full_reconcile_form" model="ir.ui.view">
		<field name="name">account.full.reconcile.form</field>
		<field name="model">account.full.reconcile</field>
        <field name="priority" eval="10" />
		<field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="name_and_move">
                        <group>
                            <field name="name" />
                            <field name="exchange_move_id" />
                        </group>
                    </group>

                    <notebook>
                        <page name="Partiali Reconciles">
                            <field name="reconciled_line_ids">
                                <tree>
                                    <field name="name" />
                                </tree>
                            </field>
                        </page>

                        <page name="Reconciled Lines">
                            <field name="reconciled_line_ids">
                                <tree>
                                    <field name="name" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
		</field>
	</record>

    <record id="account_full_reconcile_tree" model="ir.ui.view">
		<field name="name">account.full.reconcile.tree</field>
		<field name="model">account.full.reconcile</field>
		<field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="exchange_move_id" />
            </tree>
		</field>
	</record>

    <record id="action_account_full_reconcile" model="ir.actions.act_window">
        <field name="name">Account Full Reconcile</field>
        <field name="res_model">account.full.reconcile</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="account_full_reconcile_tree" />
    </record>

    <menuitem
        id="menu_account_full_reconcile"
        parent="account.account_account_menu"
        sequence="60"
        action="action_account_full_reconcile"
        groups="base.group_system"
    />
</odoo>
