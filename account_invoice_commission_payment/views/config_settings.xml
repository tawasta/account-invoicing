<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.account.commission.payment</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="100" />
    <field name="inherit_id" ref="account.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//setting[@id='print_checks']" position="after">
        <setting
          id="commission_payment"
          title="Commission payment communication"
          string="Commission payment communication"
          company_dependent="1"
          help="Default communication for commission payments"
          documentation="https://github.com/tawasta/account-invoicing"
        >
          <field name="commission_communication" />
        </setting>
      </xpath>
    </field>
  </record>
</odoo>
