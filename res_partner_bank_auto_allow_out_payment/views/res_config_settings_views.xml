<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_inherit_auto_trust" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.auto.trust</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Bank Accounts" name="bank_accounts_setting_container">
                    <setting
                        id="auto_allow_out_payment_setting"
                        string="Automatically make bank accounts trusted"
                        help="Automatically mark bank accounts as Trusted when they are created."
                    >
                        <field name="auto_allow_out_payment" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
