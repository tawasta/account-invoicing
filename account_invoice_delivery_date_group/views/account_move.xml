<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record id="view_move_form" model="ir.ui.view">
		<field name="name">account.move.form.edit.delivery.date</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_move_form" />
		<field name="arch" type="xml">
            <xpath
                expr="//group[@id='header_right_group']//field[@name='delivery_date']"
                position="attributes"
            >
                <attribute
                    name="groups"
                >!account_invoice_delivery_date_group.edit_invoice_delivery_date</attribute>
		    </xpath>

            <xpath
                expr="//group[@id='header_right_group']//field[@name='delivery_date']"
                position="after"
            >
                <field name="show_edit_delivery_date" invisible="1" />
                <field
                    name="delivery_date"
                    invisible="not show_edit_delivery_date"
                    readonly="state not in ['draft', 'posted']"
                    groups="account_invoice_delivery_date_group.edit_invoice_delivery_date"
                />
		    </xpath>
		</field>
	</record>

    <record id="view_invoice_tree" model="ir.ui.view">
        <field name="name">account.invoice.tree.delivery.date</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <field name="invoice_date_due" position="after">
                <field name="show_edit_delivery_date" column_invisible="1" />
                <field
                    name="delivery_date"
                    invisible="not show_edit_delivery_date"
                    readonly="state not in ['draft', 'posted']"
                    optional="hide"
                />
            </field>
        </field>
    </record>
</odoo>
