<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record id="view_move_form" model="ir.ui.view">
		<field name="name">account.move.form.edit.delivery.date</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_move_form" />
		<field name="arch" type="xml">
            <xpath expr="//field[@name='delivery_date']" position="attributes">
                <attribute
                    name="groups"
                >!account_invoice_delivery_date_group.edit_invoice_delivery_date</attribute>
		    </xpath>

            <xpath expr="//field[@name='delivery_date']" position="after">
                <field
                    name="delivery_date"
                    invisible="not show_delivery_date"
                    readonly="state not in ['draft', 'posted']"
                    groups="account_invoice_delivery_date_group.edit_invoice_delivery_date"
                />
		    </xpath>
		</field>
	</record>
</odoo>
