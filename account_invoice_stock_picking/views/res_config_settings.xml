<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.invoice.pickings</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="5" />
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='show_sale_receipts']" position="after">
                <setting
                    id="account_invoice_report_pickings"
                    help="Show pickings on invoice print"
                >
                    <field name="group_account_invoice_report_pickings" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
