<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit.nova.csv.export</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="last_nova_csv_export" readonly="1" />
            </xpath>
        </field>
    </record>

    <record id="action_nova_csv_export_wizard" model="ir.actions.act_window">
        <field name="name">Export CSV (Nova)</field>
        <field name="res_model">nova.csv.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
